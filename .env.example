# KhelSetu Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Server Configuration
# ===================
NODE_ENV=development
PORT=3000
SOCKET_PORT=3001

# ===================
# Neon PostgreSQL Database
# ===================
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Connection Pool Settings
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT=10000

# ===================
# JWT Configuration
# ===================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================
# Client Configuration
# ===================
CLIENT_URL=http://localhost:5173
CLIENT_API_URL=http://localhost:5173/api

# ===================
# Security
# ===================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================
# Storage (Optional)
# ===================
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# ===================
# Email (Optional)
# ===================
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@khelsetu.com

# ===================
# Logging
# ===================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===================
# Swagger
# ===================
SWAGGER_ENABLE=true
SWAGGER_TITLE=KhelSetu API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Production-grade sports tournament management API
