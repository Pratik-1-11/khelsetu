# Production Environment Variables (Set in Vercel Dashboard)
# Do NOT commit real secrets to this file

NODE_ENV=production
PORT=3000
SOCKET_PORT=3001

# Neon Postgres connection (use pooler endpoint for serverless)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-dawn-art-ap9tv71x-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Serverless-safe pool settings
PG_POOL_MIN=0
PG_POOL_MAX=1
PG_POOL_IDLE_TIMEOUT=0

JWT_SECRET=CHANGE-THIS-TO-A-STRONG-SECRET
JWT_REFRESH_SECRET=CHANGE-THIS-TO-A-STRONG-SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=https://your-frontend.vercel.app
CLIENT_API_URL=https://your-frontend.vercel.app/api

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@khelsetu.com

LOG_LEVEL=info

SWAGGER_ENABLE=true
SWAGGER_TITLE=KhelSetu API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Production-grade sports tournament management API
