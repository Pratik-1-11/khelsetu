{
  "version": 2,
  "builds": [
    {
      "src": "src/app/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app/index.js"
    }
  ],
  "functions": {
    "src/app/index.js": {
      "runtime": "nodejs20.x",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "regions": ["sin1"]
}
