{
  "name": "khelsetu-backend",
  "version": "1.0.0",
  "description": "Production-grade realtime sports tournament management platform",
  "main": "src/app/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/app/index.js",
    "dev": "node --watch src/app/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "migrate": "node src/sql/migrations/pg-run.js",
    "seed": "node src/sql/seeds/run.js",
    "seed:api": "node src/scripts/seed-api.js",
    "docs": "node src/docs/generate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^1.6.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
